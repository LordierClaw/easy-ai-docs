{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "contract"
            },
            "ref": {
              "type": "string"
            },
            "action": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "input": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "resume": {
              "default": "stop",
              "type": "string",
              "enum": [
                "retry",
                "stop"
              ]
            }
          },
          "required": [
            "type",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "choice"
            },
            "options": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ref": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "input": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "resume": {
                    "type": "string",
                    "enum": [
                      "retry",
                      "stop"
                    ]
                  },
                  "default": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "label",
                  "ref"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "options"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "message"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stop"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "wait": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "text",
            "choice",
            "confirm",
            "reboot"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "key",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "code",
    "message"
  ],
  "additionalProperties": false
}
