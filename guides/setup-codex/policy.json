{
  "probes": {
    "account": {
      "operation": "system_info"
    },
    "provider": {
      "operation": "ai_provider"
    }
  },
  "rules": [
    {
      "id": "elevated",
      "all": [
        {
          "probe": "account",
          "predicate": {
            "field": "elevated",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "reason": "Hãy đóng EasyAI và mở lại bằng tài khoản user, không dùng Run as administrator.",
      "template": "templates/request-installation.md"
    },
    {
      "id": "unsupported-windows",
      "all": [
        {
          "probe": "account",
          "predicate": {
            "field": "build",
            "operator": "lt",
            "value": 19045
          }
        }
      ],
      "reason": "Cần Windows 10 build 19045 hoặc Windows 11 x64 để dùng bộ cài này.",
      "template": "templates/request-installation.md"
    },
    {
      "id": "provider-unreachable",
      "all": [
        {
          "probe": "provider",
          "predicate": {
            "field": "reachable",
            "operator": "equals",
            "value": false
          }
        }
      ],
      "reason": "Không kết nối được API đang dùng của EasyAI. Với VM, cần API hoặc tunnel loopback hoạt động trong guest.",
      "template": "templates/request-network-access.md"
    }
  ]
}
