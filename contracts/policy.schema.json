{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "probes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][\\w-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "ai_provider"
              }
            },
            "required": [
              "operation"
            ]
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "codex_provider_status"
              }
            },
            "required": [
              "operation"
            ]
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "system_info"
              }
            },
            "required": [
              "operation"
            ]
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "find_executable"
              },
              "name": {
                "type": "string",
                "pattern": "^[\\w.-]+$"
              }
            },
            "required": [
              "operation",
              "name"
            ]
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "read_file"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "operation",
              "path"
            ]
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "read_registry"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "operation",
              "path",
              "name"
            ]
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "http_probe"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "operation",
              "url"
            ]
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "find_package"
              },
              "name": {
                "type": "string",
                "pattern": "^[\\w.*-]+$"
              }
            },
            "required": [
              "operation",
              "name"
            ]
          }
        ]
      }
    },
    "rules": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "all": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "probe": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][\\w-]*$"
                },
                "predicate": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "operator": {
                      "type": "string",
                      "enum": [
                        "equals",
                        "not_equals",
                        "exists",
                        "contains",
                        "gte",
                        "lt",
                        "version_lt"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "operator"
                  ]
                }
              },
              "required": [
                "probe",
                "predicate"
              ]
            }
          },
          "reason": {
            "type": "string"
          },
          "template": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "all",
          "reason",
          "template"
        ]
      }
    }
  },
  "required": [
    "probes",
    "rules"
  ]
}
