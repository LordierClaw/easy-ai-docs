{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runtimes": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "git",
              "node"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:\\.windows\\.\\d+)?$"
          },
          "platform": {
            "type": "string",
            "const": "win32-x64"
          },
          "format": {
            "type": "string",
            "const": "zip"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 268435456
          },
          "executable": {
            "type": "string"
          },
          "pathEntries": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "licenseUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "version",
          "platform",
          "format",
          "url",
          "sha256",
          "size",
          "executable",
          "pathEntries",
          "sourceUrl",
          "license",
          "licenseUrl"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "runtimes"
  ],
  "additionalProperties": false
}
