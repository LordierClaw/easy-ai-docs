{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "platform": {
      "type": "string",
      "const": "win32-x64"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[\\w.-]+)?$"
    },
    "tags": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "icon": {
      "default": "📖",
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "actions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "install",
          "configure",
          "repair",
          "doctor"
        ]
      }
    },
    "workflows": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "install",
          "configure",
          "repair",
          "doctor"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "platform",
    "actions"
  ]
}
